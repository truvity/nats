{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nats-broker values",
  "description": "The upstream nats chart's values go under `nats`; this chart's own are `alerts`. An unknown top-level key is refused, and in particular upstream values pasted at the root of the file, which would otherwise be ignored and install the defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nats": {
      "description": "Every value of the upstream nats chart, verbatim.",
      "type": "object"
    },
    "global": {
      "description": "Shared with the upstream chart as its own `global`.",
      "type": "object"
    },
    "alerts": {
      "description": "Opt-in alert rules for the broker's metrics.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "kind": { "type": "string", "enum": ["VMRule", "PrometheusRule"] },
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "ruleLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "groupName": { "type": "string", "minLength": 1 },
        "interval": { "$ref": "#/definitions/duration" },
        "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "runbookBaseUrl": { "type": "string" },
        "clusterLabel": { "type": "string", "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$" },
        "ownerLabel": { "type": "string", "pattern": "^([a-zA-Z_][a-zA-Z0-9_]*)?$" },
        "absentLookback": { "$ref": "#/definitions/duration" },
        "job": { "type": "string" },
        "severity": { "type": "string", "minLength": 1 },
        "warningSeverity": { "type": "string", "minLength": 1 },
        "brokerDownFor": { "$ref": "#/definitions/duration" },
        "routesFor": { "$ref": "#/definitions/duration" },
        "leaderFor": { "$ref": "#/definitions/duration" },
        "backlog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window": { "$ref": "#/definitions/duration" },
            "minPending": { "type": "integer", "minimum": 0 },
            "for": { "$ref": "#/definitions/duration" }
          }
        },
        "slowConsumers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window": { "$ref": "#/definitions/duration" },
            "for": { "$ref": "#/definitions/duration" }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "for": { "$ref": "#/definitions/duration" }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string" },
            "container": { "type": "string", "minLength": 1 },
            "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "for": { "$ref": "#/definitions/duration" }
          }
        },
        "absentFor": { "$ref": "#/definitions/duration" },
        "keepClusterLabel": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$"
    }
  }
}
