{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nats-projects values",
  "description": "An unknown key is an error.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(nats|tls)://.+"
      }
    },
    "serviceAccount": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
    },
    "tokenSecret": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
    },
    "tokenKey": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "protectAccounts": {
      "type": "boolean"
    },
    "helmKeep": {
      "type": "boolean"
    },
    "syncWave": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
